/// Maptext styles
#define MAP_STYLESHEET "img.icon { width: auto; height: auto; } .maptext { font-family: '[get_font_name(/singleton/font/grand9k)]'; font-size: 6pt; -dm-text-outline: 1px black; color: white; line-height: 1.0; } .center { text-align: center; } .langchat { font-family: '[get_font_name(/singleton/font/grand9k)]'; font-size: 6pt; -dm-text-outline: 1px black; line-height: 1.0; } .command_headset { font-weight: bold; } .context { font-family: '[get_font_name(/singleton/font/pixellari)]'; font-size: 12pt; -dm-text-outline: 1px black; } .subcontext { font-family: '[get_font_name(/singleton/font/tiny_unicode)]'; font-size: 12pt; line-height: 0.75; } .small, .langchat_small { font-family: '[get_font_name(/singleton/font/spessfont)]'; font-size: 6pt; line-height: 1.4; } .big { font-family: '[get_font_name(/singleton/font/pixellari)]'; font-size: 12pt; } .reallybig, .extremelybig { font-size: 12pt; } .greentext { color: #00FF00; font-size: 6pt; } .redtext { color: #FF0000; font-size: 6pt; } .clown { color: #FF69BF; font-weight: bold; } .his_grace { color: #15D512; } .hypnophrase { color: #0d0d0d; font-weight: bold; } .yell, .langchat_yell, .langchat_bolded { font-weight: bold; } .langchat_announce { font-family: '[get_font_name(/singleton/font/pixellari)]'; font-weight: bold; font-size: 12pt; } .langchat_bolditalicbig { font-family: '[get_font_name(/singleton/font/pixellari)]'; font-weight: bold; font-size: 24pt; font-style: italic; } .italics, .langchat_italic { font-family: '[get_font_name(/singleton/font/spessfont)]'; font-size: 6pt; line-height: 1.4; } .langchat_italic { font-style: italic; }"
