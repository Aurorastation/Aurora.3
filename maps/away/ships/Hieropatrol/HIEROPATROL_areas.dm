/area/space/rootsong
	name = "Rootsongic Space"
	icon_state = "rootsong_space"
	requires_power = TRUE
	no_light_control = FALSE
	ambience = AMBIENCE_DIONA
	static_lighting = FALSE
	base_lighting_alpha = 255
	area_blurb = "A great choir sings through space like a wind in a language you do not understand, ringing out in orderly chirps and windy howls in a grandiose manner, while a brownish-green mass lays drifting nearby where the song eminates, it is organic and smooth, but designed with purpose and warlike in appearance as a light eminnates from it's sides."

/area/hieropatrol
	name = "Rotunnkc Compact Corvette"
	icon_state = "bridge"
	requires_power = TRUE
	no_light_control = FALSE
	ambience = AMBIENCE_DIONA
	area_blurb = "You feel the biomass walls around you curve and shift as if breathing, small particles drift across the space between them shining light across the space as organic bulbs glow bellow. \
	The choir hums gently inside the bowels of the vessel, insulated from the outside, the floors are hard and built up like roots and normal legs would have some difficulty with them."

/area/hieropatrol/bridge
	name = "Rotunnkc Compact Corvette - Bridge"
	icon_state = "bridge"
	area_blurb = "The maw and mind of the beast, from here, consoles and sensors whirr ensuring every aspect of the vessel can be coordinated and bent to heel by steel. \
	The view obscured by grilles shows two jagged protrusions from the main vessel, narrowing into a focus shielding the bridge from the outside."


